  "scripts": {
    "start": "nx serve",
    "watch": "ng build --watch --configuration development",
    "dev": "node tools/dev.mjs",
    "seed": "node tools/seed-emulator.mjs",
    "start:emulators": "firebase emulators:start --only auth,firestore",
    "api:dev": "nx serve api",
    "dashboard:dev": "nx serve dashboard --host=0.0.0.0 --port=4200",
    "build": "nx run-many --target=build --projects=dashboard,api --parallel=2 --outputStyle=static",
    "test": "nx run-many --target=test --projects=dashboard,api,models,channels --parallel=2 --outputStyle=static",
    "lint": "nx run-many --target=lint --projects=dashboard,api,models,channels --parallel=2 --outputStyle=static"
  },
  "private": true,
